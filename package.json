{
  "name": "courier",
  "version": "1.0.0-alpha.1",
  "description": "Postman-style API Testing Platform",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"red,cyan\" \"node server/server.js\" \"vite --configLoader native\"",
    "dev:server": "node server/server.js",
    "dev:client": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "build:web": "./scripts/build.sh web",
    "build:all": "./scripts/build.sh all",
    "build:script": "./scripts/build.sh",
    "preview": "vite preview --configLoader native",
    "electron": "npx electron .",
    "electron:dev": "concurrently -n \"SERVER,CLIENT,ELECTRON\" -c \"red,cyan,magenta\" \"node server/server.js\" \"vite --configLoader native\" \"wait-on http://localhost:5173 && wait-on http://localhost:5001/api/health && npx electron .\"",
    "electron:preview": "npm run build && concurrently -n \"SERVER,ELECTRON\" -c \"red,magenta\" \"node server/server.js\" \"wait-on http://localhost:5001/api/health && npx electron .\"",
    "pack": "npm run build && npx electron-builder --dir",
    "dist": "npm run build && npx electron-builder",
    "dist:linux": "npm run build && npx electron-builder --linux AppImage deb",
    "dist:linux:deb": "npm run build && npx electron-builder --linux deb",
    "dist:linux:appimage": "npm run build && npx electron-builder --linux AppImage",
    "dist:mac": "npm run build && npx electron-builder --mac",
    "dist:mac:arm64": "npm run build && npx electron-builder --mac --arm64",
    "dist:mac:universal": "npm run build && npx electron-builder --mac --universal",
    "dist:mac:x64": "npm run build && npx electron-builder --mac --x64",
    "dist:win": "npm run build && npx electron-builder --win",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "firebase:serve": "npm run build && firebase serve --only hosting"
  },
  "keywords": [
    "postman",
    "api-tester",
    "rest-client",
    "react",
    "express",
    "electron",
    "desktop-app"
  ],
  "author": "Courier Team <dev@courier.dev>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.4",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "vite": "^8.3.8",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.courier.app",
    "productName": "Courier",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "dist/**/*"
    ],
    "mac": {
      "icon": "electron/assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64",
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Courier Team <dev@courier.dev>",
      "category": "Development"
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "devel"
    }
  }
}
